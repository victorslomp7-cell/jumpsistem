# Copie para .env.local e preencha com as credenciais do seu projeto Supabase
# (Project Settings → API, no dashboard do Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usada só em Route Handlers/Edge Functions administrativas (nunca exposta ao browser).
SUPABASE_SERVICE_ROLE_KEY=

# Fase 7 (Web Push) — gerar com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Fase 7 — segredo compartilhado com o Database Webhook do Supabase
# (Database → Webhooks), enviado no header "x-webhook-secret" pra só ele
# poder chamar /api/push/notify. Gerar com: openssl rand -hex 24
PUSH_WEBHOOK_SECRET=
